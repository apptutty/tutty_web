# ─── E2E environment configuration (Admin / Web) ─────────────────────────────
# Copy this file to `.env` inside `web/e2e/` and fill in real values.
# `.env` is gitignored — NEVER commit real credentials.
#
# IMPORTANT: mobile and web currently share a SINGLE Supabase project for both
# dev and prod (see src/environments/environment.ts). There is no isolated
# staging database. These tests MUST use dedicated QA accounts and must never
# perform destructive cleanup without explicitly confirming the target project.

# Base URL where `ng serve` for the admin app is reachable (see webServer in playwright.config.ts)
E2E_BASE_URL=http://localhost:4210

# Supabase project used for E2E (must match src/environments/environment.ts)
E2E_SUPABASE_URL=https://sjfyrhqdypwnauetvpju.supabase.co
E2E_SUPABASE_ANON_KEY=sb_publishable_OCV30cI72vPeh8s1_by4og_W9KeOjzB

# ── QA test account (role: super_admin) ──────────────────────────────────────
# Required to reach /beaches (roleGuard(['super_admin'])).
QA_SUPER_ADMIN_EMAIL=
QA_SUPER_ADMIN_PASSWORD=

# ── QA test account (role: store_admin) ──────────────────────────────────────
# Used to confirm role-based redirect (-> /store) and that store_admin cannot
# reach super_admin-only routes like /beaches.
QA_STORE_ADMIN_EMAIL=
QA_STORE_ADMIN_PASSWORD=
